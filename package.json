{
  "name": "fantasy-cricket",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fantasy-cricket/web",
    "dev:api": "npm run dev --workspace @fantasy-cricket/api",
    "build": "npm run build --workspace @fantasy-cricket/web",
    "build:api": "npm run build --workspace @fantasy-cricket/api",
    "preview": "npm run preview --workspace @fantasy-cricket/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit && npm run typecheck --workspace @fantasy-cricket/shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
